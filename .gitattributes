# Normalize text files
* text=auto

# Source / structured text
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.kml   text eol=lf
*.gpx   text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf

# Windows scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.kmz   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.zip   binary
*.rar   binary